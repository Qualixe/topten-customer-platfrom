# Copy this to .env.prod and fill in real values before deploying.
# Never commit .env.prod — it's in .gitignore.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=topten
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=topten

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ── Backend ─────────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=change-me-at-least-32-random-chars

# Used only by `python -m scripts.seed_auth` (run once, manually, after the
# first deploy) to create the bootstrap admin account. Change the password
# here before running it — the app refuses to start in production with the
# default value.
INITIAL_ADMIN_EMAIL=admin@qualixe.com
INITIAL_ADMIN_PASSWORD=change-me-strong-admin-password

# Comma-separated list of allowed CORS origins (the frontend domain)
CORS_ORIGINS=https://sms.topten.com.bd

# Used in SMS campaign links
FRONTEND_BASE_URL=https://sms.topten.com.bd

# Used to build absolute links back to the API itself (e.g. in outbound
# messages) — the backend/celery_worker/celery_beat containers all read this.
API_PUBLIC_BASE_URL=https://sms-api.topten.com.bd

# ── Frontend ─────────────────────────────────────────────────────────────────
# This is baked into the Next.js build — must point to the public API domain
NEXT_PUBLIC_API_BASE_URL=https://sms-api.topten.com.bd/api/v1
