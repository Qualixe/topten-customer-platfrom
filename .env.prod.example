# Copy this to .env.prod and fill in real values before deploying.
# Never commit .env.prod — it's in .gitignore.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=topten
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=topten

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ── Backend ─────────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=change-me-at-least-32-random-chars

# Comma-separated list of allowed CORS origins (your frontend domain)
CORS_ORIGINS=https://your-domain.com

# Used in SMS campaign links
FRONTEND_BASE_URL=https://your-domain.com

# ── Frontend ─────────────────────────────────────────────────────────────────
# This is baked into the Next.js build — must point to your public API URL
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com/api/v1
